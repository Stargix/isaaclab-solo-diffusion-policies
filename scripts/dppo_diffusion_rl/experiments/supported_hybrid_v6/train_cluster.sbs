#!/usr/bin/env bash
#SBATCH --job-name=dppo_hyv6
#SBATCH --output=/home/sflores/i2r/slurm_logs/slurm-%x-%j.out
#SBATCH --error=/home/sflores/i2r/slurm_logs/slurm-%x-%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=50G
#SBATCH --time=24:00:00
#SBATCH --gres=gpu:lovelace:1

set -Eeuo pipefail

export EGL_VISIBLE_DEVICES=0
export PHYSX_GPU_DEVICE=0
export OMNI_KIT_GPU_ID=0

if [[ -f "${HOME}/miniconda3/etc/profile.d/conda.sh" ]]; then
  CONDA_SH="${HOME}/miniconda3/etc/profile.d/conda.sh"
elif [[ -f "/etc/profile.d/conda.sh" ]]; then
  CONDA_SH="/etc/profile.d/conda.sh"
else
  CONDA_SH="$(conda info --base)/etc/profile.d/conda.sh"
fi
set +eu
source "${CONDA_SH}"
conda activate env_isaaclab
set -eu

ISAACLAB_DIR="${HOME}/i2r/isaaclab-solo-diffusion-policies"
cd "${ISAACLAB_DIR}"
export PYTHONPATH="${ISAACLAB_DIR}:${PYTHONPATH:-}"
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export NCCL_P2P_DISABLE=1
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:1024
export MALLOC_ARENA_MAX=1
export TMPDIR="${HOME}/i2r/tmp"
mkdir -p "${TMPDIR}"

RUN_DIR="scripts/dppo_diffusion_rl/runs/dppo_wct_supported_hybrid_v6_consolidation"
CHECKPOINT_PATH="${1:-scripts/dppo_diffusion_rl/runs/dppo_wct_supported_hybrid_v3/best.pt}"
if [[ ! -f "${CHECKPOINT_PATH}" ]]; then
  FALLBACK="checkpoints_iri/checkpoints_dppo/dppo_wct_hybrid_strict.pt"
  if [[ -f "${FALLBACK}" ]]; then
    CHECKPOINT_PATH="${FALLBACK}"
  else
    echo "Exact benchmarked v3 checkpoint not found: ${CHECKPOINT_PATH}" >&2
    echo "Fallback checkpoint not found: ${FALLBACK}" >&2
    exit 2
  fi
fi

EXPECTED_SHA256="5258fcf239a391bcfe6e4a951944b037b94441113d137b782ad5ade8341fa55f"
ACTUAL_SHA256="$(sha256sum "${CHECKPOINT_PATH}" | cut -d ' ' -f 1)"
if [[ "${ACTUAL_SHA256}" != "${EXPECTED_SHA256}" ]]; then
  echo "Refusing an unvalidated v3 source checkpoint." >&2
  echo "Expected: ${EXPECTED_SHA256}" >&2
  echo "Actual:   ${ACTUAL_SHA256}" >&2
  exit 3
fi
if [[ -d "${RUN_DIR}" ]] && [[ -n "$(find "${RUN_DIR}" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
  echo "Refusing to overwrite populated run directory: ${RUN_DIR}" >&2
  exit 4
fi

echo "Using exact paired-benchmark v3 actor: ${CHECKPOINT_PATH}"
echo "Checkpoint SHA256: ${ACTUAL_SHA256}"
echo "Output directory: ${RUN_DIR}"
nvidia-smi

./isaaclab.sh -p scripts/dppo_diffusion_rl/train.py \
  --checkpoint "${CHECKPOINT_PATH}" \
  --restart_optimization \
  --output_dir "${RUN_DIR}" \
  --run_name dppo_wct_supported_hybrid_v6_consolidation \
  --route_distribution supported_hybrid_v6 \
  --route_speed_max_mps 1.0 \
  --speed_budget_max_mps 1.5 \
  --transition_boundary_min_m 0.8 \
  --transition_boundary_max_m 3.2 \
  --path_reward_weight 2.0 \
  --route_cte_rmse_tolerance_m 0.10 \
  --profile_height_reward_weight 0.75 \
  --profile_height_mae_tolerance_m 0.04 \
  --reference_kl_coef 0.01 \
  --reference_kl_update_group 0 \
  --actor_lr 5e-6 \
  --num_envs 4096 \
  --iterations 120 \
  --rollout_chunks 32 \
  --save_interval 5 \
  --seed 42 \
  --headless \
  --device cuda:0 \
  --wandb

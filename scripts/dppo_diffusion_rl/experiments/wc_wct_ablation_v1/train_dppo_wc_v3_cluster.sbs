#!/usr/bin/env bash
#SBATCH --job-name=dppo_wcv3
#SBATCH --output=/home/sflores/i2r/slurm_logs/slurm-%x-%j.out
#SBATCH --error=/home/sflores/i2r/slurm_logs/slurm-%x-%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=50G
#SBATCH --time=24:00:00
#SBATCH --gres=gpu:lovelace:1

set -Eeuo pipefail

export EGL_VISIBLE_DEVICES=0
export PHYSX_GPU_DEVICE=0
export OMNI_KIT_GPU_ID=0

if [[ -f "${HOME}/miniconda3/etc/profile.d/conda.sh" ]]; then
  CONDA_SH="${HOME}/miniconda3/etc/profile.d/conda.sh"
elif [[ -f "/etc/profile.d/conda.sh" ]]; then
  CONDA_SH="/etc/profile.d/conda.sh"
else
  CONDA_SH="$(conda info --base)/etc/profile.d/conda.sh"
fi
set +eu
source "${CONDA_SH}"
conda activate env_isaaclab
set -eu

ISAACLAB_DIR="${HOME}/i2r/isaaclab-solo-diffusion-policies"
cd "${ISAACLAB_DIR}"
export PYTHONPATH="${ISAACLAB_DIR}:${PYTHONPATH:-}"
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export NCCL_P2P_DISABLE=1
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:1024
export MALLOC_ARENA_MAX=1
export TMPDIR="${HOME}/i2r/tmp"
mkdir -p "${TMPDIR}"

RUN_DIR="scripts/dppo_diffusion_rl/runs/dppo_wc_supported_hybrid_v3"
EXPECTED_SHA="b94a6ae7e1da298ff0a33b314adc5e6639a059a61452d423cd926fd9103fedbd"
CHECKPOINT_PATH="${1:-checkpoints_iri/checkpoints_dp/wc_wct_phase_a.pt}"
if [[ ! -f "${CHECKPOINT_PATH}" ]]; then
  FALLBACK="scripts/diffusion_policy/runs/wc_wct_ablation_v1_phase_a_wc_k10/best.pt"
  if [[ -f "${FALLBACK}" ]]; then
    CHECKPOINT_PATH="${FALLBACK}"
  else
    echo "Pure Phase-A WC checkpoint not found: ${CHECKPOINT_PATH}" >&2
    echo "Fallback checkpoint not found: ${FALLBACK}" >&2
    exit 2
  fi
fi

ACTUAL_SHA="$(sha256sum "${CHECKPOINT_PATH}" | awk '{print $1}' | tr '[:upper:]' '[:lower:]')"
if [[ "${ACTUAL_SHA}" != "${EXPECTED_SHA}" ]]; then
  echo "Refusing an unvalidated Phase-A WC checkpoint." >&2
  echo "Expected: ${EXPECTED_SHA}" >&2
  echo "Actual:   ${ACTUAL_SHA}" >&2
  exit 3
fi

echo "Using pure Phase-A WC checkpoint: ${CHECKPOINT_PATH}"
echo "checkpoint_sha256=${ACTUAL_SHA}"
echo "Output directory: ${RUN_DIR}"
nvidia-smi

./isaaclab.sh -p scripts/dppo_diffusion_rl/train.py \
  --checkpoint "${CHECKPOINT_PATH}" \
  --require_phase_a_source \
  --output_dir "${RUN_DIR}" \
  --run_name dppo_wc_supported_hybrid_v3 \
  --route_distribution supported_hybrid_v3 \
  --route_speed_max_mps 1.0 \
  --speed_budget_max_mps 1.5 \
  --transition_boundary_min_m 0.8 \
  --transition_boundary_max_m 3.2 \
  --path_reward_weight 2.0 \
  --route_cte_rmse_tolerance_m 0.10 \
  --profile_height_reward_weight 0.75 \
  --profile_height_mae_tolerance_m 0.04 \
  --reference_kl_coef 0.0 \
  --num_envs 4096 \
  --iterations 150 \
  --rollout_chunks 32 \
  --save_interval 10 \
  --seed 42 \
  --headless \
  --device cuda:0 \
  --wandb

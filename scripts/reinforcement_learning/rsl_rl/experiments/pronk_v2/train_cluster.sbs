#!/usr/bin/env bash
#SBATCH --job-name=solo_pronk_v2
#SBATCH --output=/home/sflores/i2r/slurm_logs/slurm-%x-%j.out
#SBATCH --error=/home/sflores/i2r/slurm_logs/slurm-%x-%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=50G
#SBATCH --time=12:00:00
#SBATCH --gres=gpu:lovelace:1

set -Eeuo pipefail

export EGL_VISIBLE_DEVICES=0
export PHYSX_GPU_DEVICE=0
export OMNI_KIT_GPU_ID=0

if [[ -f "${HOME}/miniconda3/etc/profile.d/conda.sh" ]]; then
  CONDA_SH="${HOME}/miniconda3/etc/profile.d/conda.sh"
elif [[ -f "/etc/profile.d/conda.sh" ]]; then
  CONDA_SH="/etc/profile.d/conda.sh"
else
  CONDA_SH="$(conda info --base)/etc/profile.d/conda.sh"
fi

set +eu
source "${CONDA_SH}"
conda activate env_isaaclab
set -eu

ISAACLAB_DIR="${HOME}/i2r/isaaclab-solo-diffusion-policies"
cd "${ISAACLAB_DIR}"
export PYTHONPATH="${ISAACLAB_DIR}/source/isaaclab_tasks:${ISAACLAB_DIR}/source/scripts/skrl:${ISAACLAB_DIR}:${PYTHONPATH:-}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export NCCL_P2P_DISABLE=1 PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:1024 MALLOC_ARENA_MAX=1
export PYTHONUNBUFFERED=1
export TMPDIR="${HOME}/i2r/tmp"
mkdir -p "${TMPDIR}"
export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
export SSL_CERT_DIR=/etc/ssl/certs
export CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

CHECKPOINT="${1:-checkpoints/jumpy_safe.pt}"
EXPECTED_SHA="6496d831f4d3b8fec8793eb740351edbe6581198787d713ac7010371a0ff4183"
[[ -f "${CHECKPOINT}" ]] || { echo "Missing warm-start checkpoint: ${CHECKPOINT}" >&2; exit 3; }
ACTUAL_SHA="$(sha256sum "${CHECKPOINT}" | awk '{print $1}')"
[[ "${ACTUAL_SHA}" == "${EXPECTED_SHA}" ]] || {
  echo "Unexpected checkpoint SHA256: ${ACTUAL_SHA}" >&2
  echo "Expected: ${EXPECTED_SHA}" >&2
  exit 3
}

SOURCE_FILES=(
  source/isaaclab_tasks/isaaclab_tasks/direct/solo12/pronk_gait.py
  source/isaaclab_tasks/isaaclab_tasks/direct/solo12/pronk_ppo.py
  source/isaaclab_tasks/isaaclab_tasks/direct/solo12/solo12_pronk_env.py
  source/isaaclab_tasks/isaaclab_tasks/direct/solo12/solo12_pronk_v2.py
  source/isaaclab_tasks/isaaclab_tasks/direct/solo12/__init__.py
  scripts/reinforcement_learning/rsl_rl/experiments/pronk_v1/test_pronk_gait.py
  scripts/reinforcement_learning/rsl_rl/experiments/pronk_v2/README.md
  scripts/reinforcement_learning/rsl_rl/experiments/pronk_v2/train_cluster.sbs
  scripts/reinforcement_learning/rsl_rl/train.py
  scripts/reinforcement_learning/rsl_rl/warm_start.py
  source/isaaclab_tasks/isaaclab_tasks/direct/solo12/solo12_env.py
  source/isaaclab_tasks/isaaclab_tasks/direct/solo12/solo12_env_cfg.py
  source/isaaclab_tasks/isaaclab_tasks/direct/solo12/agents/rsl_rl_ppo_cfg.py
  source/scripts/skrl/solo12_symmetry.py
)
for file in "${SOURCE_FILES[@]}"; do
  git ls-files --error-unmatch "${file}" >/dev/null || {
    echo "Experiment file is not tracked/committed: ${file}" >&2
    exit 4
  }
done
if ! git diff --quiet HEAD -- "${SOURCE_FILES[@]}"; then
  echo "Pronk v2 source differs from HEAD; commit/pull the reviewed implementation first." >&2
  git status --short >&2
  exit 4
fi

echo "--- Pronk v2 provenance ---"
echo "SLURM_JOB_ID=${SLURM_JOB_ID:-manual}"
echo "GIT_COMMIT=$(git rev-parse HEAD)"
echo "ISAAC_SIM=$(python -c 'import importlib.metadata as m; print(m.version("isaacsim"))')"
echo "RSL_RL=$(python -c 'import importlib.metadata as m; print(m.version("rsl-rl-lib"))')"
echo "CHECKPOINT=${CHECKPOINT}"
echo "CHECKPOINT_SHA256=${ACTUAL_SHA}"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi

python -m unittest discover \
  -s scripts/reinforcement_learning/rsl_rl/experiments/pronk_v1 \
  -p 'test_pronk_gait.py'

SMOKE_RUN="pronk_v2_smoke_seed42_job${SLURM_JOB_ID:-manual}"
./isaaclab.sh -p scripts/reinforcement_learning/rsl_rl/train.py \
  --task solo12-pronk-v2-v0 \
  "agent.algorithm.reference_checkpoint=${CHECKPOINT}" \
  --num_envs 8 --max_iterations 2 --seed 42 \
  --run_name "${SMOKE_RUN}" --logger tensorboard \
  --headless --device cuda:0

TRAIN_RUN="pronk_v2_reference_preserving_seed42_job${SLURM_JOB_ID:-manual}"
./isaaclab.sh -p scripts/reinforcement_learning/rsl_rl/train.py \
  --task solo12-pronk-v2-v0 \
  "agent.algorithm.reference_checkpoint=${CHECKPOINT}" \
  --num_envs 4096 --max_iterations 1000 --seed 42 \
  --run_name "${TRAIN_RUN}" --logger wandb \
  --log_project_name solo12-pronk --headless --device cuda:0
